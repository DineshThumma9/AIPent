FROM python:3.12-slim

RUN apt-get update && apt-get install -y git --no-install-recommends && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.2 /uv /bin/

WORKDIR /app

RUN git clone --depth 1 https://github.com/mez-0/vulnify.git /opt/vulnify

WORKDIR /opt/vulnify

RUN uv sync --extra mcp --no-cache

COPY bridge.py /app/bridge.py

ENV VULNIFY_SQL_PATH=/data/vulnify.db
ENV VULNIFY_SQLITE_PATH=/data/vulnify.db
ENV VULNIFY_SCHEMA_SQL_PATH=/opt/vulnify/vulnify/db/schema.sql
ENV PYTHONUNBUFFERED=1

EXPOSE 7457

ENTRYPOINT ["python", "/app/bridge.py"]
