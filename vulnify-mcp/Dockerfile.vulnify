# Vulnify FastMCP Server Bridge
# Provides an HTTP wrapper around mez-0/vulnify stdio FastMCP server.
FROM python:3.12-slim

LABEL maintainer="AIPENT Team"
LABEL description="Vulnify CVE FastMCP server container"

RUN apt-get update && apt-get install -y git curl --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/

WORKDIR /app

# Clone upstream mez-0/vulnify repository
RUN git clone --depth 1 https://github.com/mez-0/vulnify.git /opt/vulnify

WORKDIR /opt/vulnify
RUN uv sync --extra mcp --no-cache

WORKDIR /app
COPY bridge.py /app/bridge.py

ENV VULNIFY_SQLITE_PATH=/data/vulnify.db
ENV VULNIFY_SCHEMA_SQL_PATH=/opt/vulnify/vulnify/db/schema.sql
ENV PYTHONUNBUFFERED=1

EXPOSE 7457

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -fsS http://127.0.0.1:7457/health || exit 1

ENTRYPOINT ["python", "/app/bridge.py"]
