FROM python:3.12-slim 


COPY --from=ghcr.io/astral-sh/uv:0.9.2 /uv /bin/

WORKDIR /app

RUN git clone --depth 1 https://github.com/mez-0/vulnify.git  /opt/vulnify


WORKDIR /opt/vulnify

RUN uv sync --extra mcp --no-cache 




ENV VULNIFY_SQL_PATH=/data/vulnify.db 
ENV VULNIFY_SCHEMA_SQL_PATH=/opt/vulnify/vulnify/db/schema.sql 
ENV PYTHONUNBUFFERED=1 



ENTRYPOINT [ "uv" , "run" ,"--directory" , "/opt/vulnify" , "vulnify-mcp" ]



