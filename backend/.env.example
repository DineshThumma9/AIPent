# ==============================================================================
# AIPENT Environment Configuration Example
# Copy this file to `backend/.env` and adjust the values as needed.
# ==============================================================================

# --- LLM Provider & API Keys ---
# Provider: "openrouter" | "ollama" | "openai" | "anthropic" | "gemini"
AIPENT_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# (Optional) Direct provider keys if not using OpenRouter
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Model Selection ---
# Unified default model or per-role overrides
AIPENT_LLM_MODEL=anthropic/claude-3.5-sonnet
AIPENT_SUPERVISOR_MODEL=
AIPENT_REPORT_MODEL=
AIPENT_COORDINATOR_MODEL=
AIPENT_RECON_MODEL=
AIPENT_DISCOVERY_MODEL=
AIPENT_VALIDATION_MODEL=

# --- MCP Gateway Transport (Problem Statement §4) ---
# When true, tools run isolated in Docker via MCP Gateway (port 8812)
AIPENT_MCP_ENABLED=true
AIPENT_MCP_TRANSPORT=gateway
AIPENT_MCP_GATEWAY_URL=http://127.0.0.1:8812/sse
AIPENT_LAB_TARGET_ALIAS=host.docker.internal

# --- Vulnify Offline CVE Catalog (§5.5 Zero-Hallucination Intelligence) ---
# Path to the offline SQLite database (run ./setup_vulnify.sh to prepare)
VULNIFY_SQLITE_PATH=vulnify.db

# --- Execution & Safety Budgets ---
AIPENT_MAX_AGENT_TURNS=40
AIPENT_SCAN_TIMEOUT=600
AIPENT_RUN_TIMEOUT=1800

# --- Telemetry & Tracing (Optional) ---
LANGCHAIN_TRACE=false
LANGCHAIN_PROJECT=aipent
LANGSMITH_API_KEY=
