{
  "storage_dirs": {
    "default": ["/public", "/downloads", "/uploads", "/files", "/static"],
    "ftp": ["/ftp", "/ftp/", "/ftp/downloads", "/ftp/legal", "/ftp/acquisitions"],
    "public": ["/public", "/public/", "/public/downloads", "/public/uploads"],
    "supports": ["/support", "/support/downloads", "/static", "/assets/files"],
    "data": ["/data", "/storage", "/media", "/attachments"]
  },
  "backup_extensions": [".bak", ".old", ".swp", ".swo", ".orig", ".save", ".tmp", ".backup", "~", ".copy", ".inc"],
  "vcs_paths": [
    ".git/HEAD",
    ".git/config",
    ".git/description",
    ".svn/wc.db",
    ".svn/entries",
    ".hg/hgrc",
    ".DS_Store",
    "CVS/Entries"
  ],
  "config_files": [
    "/package.json",
    "/composer.json",
    "/requirements.txt",
    "/Pipfile",
    "/pyproject.toml",
    "/go.mod",
    "/pom.xml",
    "/build.gradle",
    "/Gemfile",
    "/config.json",
    "/config.yml",
    "/settings.py",
    "/.env",
    "/.env.local",
    "/.env.production",
    "/app.config.js",
    "/local.settings.json",
    "/application.properties",
    "/web.config",
    "/httpd.conf",
    "/nginx.conf"
  ],
  "docs_and_meta": [
    "/README.md",
    "/readme.md",
    "/CHANGELOG.md",
    "/CONTRIBUTING.md",
    "/LICENSE",
    "/MODELS_SPEC.md",
    "/ARCHITECTURE.md",
    "/robots.txt",
    "/sitemap.xml",
    "/humans.txt"
  ],
  "ide_editor_files": [
    "/.idea/workspace.xml",
    "/.vscode/settings.json",
    "/.project",
    "/.classpath",
    "/nbproject/project.xml"
  ],
  "cloud_docker": [
    "/docker-compose.yml",
    "/docker-compose.yaml",
    "/Dockerfile",
    "/.dockerenv",
    "/k8s/deployment.yaml",
    "/.well-known/openid-configuration.json"
  ]
}